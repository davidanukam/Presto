{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presto",
  "version": "0.1.0",
  "identifier": "com.presto.studio",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm --dir ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Presto",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["presto"],
        "name": "Presto score",
        "mimeType": "text/plain"
      }
    ]
  }
}
